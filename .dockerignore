# keep the docker build context small: exclude VCS, build outputs, the huge
# test262 checkout (make test does not need it), and host binaries/artifacts.
.git
.obj
test262
test262o
# **/ matters: a bare *.a matches the ROOT ONLY, so the host-built
# third_party/openlibm/libopenlibm.a was copied in -- an arm64 archive that
# cannot link in an amd64 image.
**/*.a
**/*.o
**/*.d
**/*.so
dynajs
dynajsc
dynajs-debug
run-test262
run-test262-debug
host-dynajsc
repl.c
*.dSYM
