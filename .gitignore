# local analysis / planning docs (not for commit)
*.md
# ...but DO commit the user-facing guide under docs/ and the root README
# (overrides the *.md ignore above)
!docs/
!docs/**
!/README.md
# `bench/` is local reports and scratch -- EXCEPT the code graph, which
# CLAUDE.md tells every session to run and which only existed on one machine.
# `bench/` with a trailing slash excludes the directory, and a negation cannot
# re-include a file whose parent is excluded; `bench/*` excludes the contents
# instead, which a negation can override.
bench/*
!bench/codegraph.py

# local tooling (agent worktrees, settings)
.claude/

# libFuzzer target binaries (build artifacts)
fuzz_bytecode
fuzz_json
fuzz_module_export
fuzz_eval
fuzz_compile
fuzz_regexp

# vendored external experiments (mimalloc, etc.)
third_party/

# PGO artifacts
pgo-data/
pgo.profdata

# macOS Finder metadata
.DS_Store
*.dSYM/
fuzz_net

# Fuzzer and crash artefacts. libFuzzer writes a reproducer into the CWD on every
# finding, and a fault-injection run produces one per injected bug -- reproducers
# for defects that do not exist, which is worse than noise once committed. The
# corpus is regenerated by running the target and is not a source input.
crash-*
leak-*
timeout-*
oom-*
slow-unit-*
fuzz-*.log
*.profraw
*.profdata

# Core dumps and OS crash reports
core
core.*
vgcore.*
*.crash
*.ips
*.dmp

# Working changelog: a running record of what landed and what it measured.
# Gitignored on purpose -- the commit messages are the shared history; this is
# the scratch that feeds them.
CHANGELOG.local.md
.dev/
fuzz_stdlib
fuzz_dyns
fuzz_lz4
fuzz_scram
fuzz_regexp_compile
.build-variant
test-tls
test-aio-tls

# python bytecode cache from the pty test harness
__pycache__/
fuzz_codec
fuzz_csv
